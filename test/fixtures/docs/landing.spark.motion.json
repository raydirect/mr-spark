{
  "$schema": "https://mr-spark.pages.dev/schema/motion-0.1.json",
  "version": "0.1",
  "$comment": "One entrance, one staggered list, one decorative loop the verifier is allowed to complain about. The referenced animation carries no trigger: the timeline owns when it plays.",
  "meta": { "name": "landing motion" },

  "defaults": { "duration": "motion.base", "easing": "ease-out", "reducedMotion": "instant" },

  "animations": [
    {
      "id": "hero-in",
      "target": { "id": "hero-title" },
      "from": { "opacity": "0", "translateY": "12px" },
      "to": { "opacity": "1", "translateY": "0" },
      "duration": "motion.fast"
    }
  ],

  "timelines": [
    {
      "id": "hero",
      "intent": "entrance",
      "trigger": { "on": "load" },
      "labels": { "badge": "0.2s" },
      "items": [
        { "ref": "hero-in" },
        {
          "at": "<",
          "target": { "id": "hero-offers", "each": "children" },
          "stagger": { "each": "motion.fast", "from": "center" },
          "from": { "opacity": "0", "translateY": "8px" },
          "to": { "opacity": "1", "translateY": "0" },
          "easing": "power2.out"
        },
        {
          "at": "label:badge",
          "target": { "id": "hero-image" },
          "intent": "decorative",
          "to": { "rotate": "3deg" },
          "repeat": "infinite",
          "yoyo": true,
          "duration": "motion.base"
        }
      ]
    }
  ],

  "machines": {
    "menu": {
      "initial": "closed",
      "states": {
        "closed": { "on": { "toggle": "open" } },
        "open": { "on": { "toggle": "closed" }, "effects": ["hero-in"] }
      }
    }
  }
}
