{
  "name": "webspark",
  "version": "0.2.0",
  "description": "Every artifact proves itself. A conformance compiler for the web: one IR in, honest findings out.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spark": "./bin/spark.js"
  },
  "exports": {
    ".": "./src/engine.js",
    "./ir": "./src/ir.js",
    "./score": "./src/score.js",
    "./view-model": "./src/view-model.js",
    "./tokens": "./src/config/tokens.js",
    "./tokens.json": "./src/config/tokens.json",
    "./formats": "./src/formats/index.js",
    "./schema/*": "./schema/*"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:self": "node bin/spark.js check fixtures/bad.html",
    "tokens": "node -e \"import('./src/reporters/styles.js').then(m=>process.stdout.write(m.renderStyles()))\"",
    "formats:generate": "node src/formats/generate.js",
    "formats:check": "node src/formats/generate.js --check"
  },
  "dependencies": {
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1"
  }
}
