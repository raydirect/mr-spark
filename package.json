{
  "name": "mr-spark",
  "version": "0.2.0",
  "description": "Every artifact proves itself. A conformance compiler for the web: one IR in, honest findings out.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raydirect/web-spark.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spark": "./bin/spark.js"
  },
  "exports": {
    ".": "./src/engine.js",
    "./ir": "./src/ir.js",
    "./score": "./src/score.js",
    "./view-model": "./src/view-model.js",
    "./tokens": "./src/config/tokens.js",
    "./tokens.json": "./src/config/tokens.json",
    "./formats": "./src/formats/index.js",
    "./lower": "./src/lower.js",
    "./emit": "./src/emit.js",
    "./ease-bake": "./src/ease-bake.js",
    "./schema/*": "./schema/*"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "docs",
    "LICENSE",
    "LICENSE-PENNER.txt",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:self": "node bin/spark.js check fixtures/bad.html",
    "tokens": "node -e \"import('./src/reporters/styles.js').then(m=>process.stdout.write(m.renderStyles()))\"",
    "formats:generate": "node src/formats/generate.js",
    "formats:check": "node src/formats/generate.js --check",
    "schema:serve": "node src/publish.js serve",
    "schema:bundle": "node src/publish.js bundle --out dist",
    "schema:verify": "node src/publish.js verify"
  },
  "dependencies": {
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1"
  },
  "homepage": "https://github.com/raydirect/web-spark"
}
