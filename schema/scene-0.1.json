  "$id": "https://web-spark.dev/schema/scene-0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structure, layout, states and assets for one page. Compiles to semantic HTML and CSS, and nothing else.",
  "properties": {
    "$schema": {
      "const": "https://web-spark.dev/schema/scene-0.1.json",
      "description": "The schema this document claims to satisfy. Required, so a document cannot be validated against the wrong vocabulary by accident."
    },
    "a11y": {
      "additionalProperties": false,
      "properties": {
        "landmarks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "contains": {
                "$ref": "#/$defs/id",
                "description": "The component that carries this landmark. One id, so the mapping is auditable rather than implied."
              },
              "role": {
                "enum": [
                  "banner",
                  "navigation",
                  "main",
                  "complementary",
                  "contentinfo",
                  "search",
                  "form",
                  "region"
                ],
                "type": "string"
              }
            },
            "required": [
              "contains",
              "role"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "skipLink": {
          "description": "Emitted as the first focusable element on the page, pointing at `main`.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "assets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "altDefault": {
            "description": "Fallback alt text for an asset used without an explicit `alt`.",
            "maxLength": 300,
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "svg",
              "png",
              "jpg",
              "webp",
              "avif",
              "woff2"
            ],
            "type": "string"
          },
          "path": {
            "description": "Relative to this document. An absolute path is a build that only works on one machine.",
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "description": "Content address. A changed file with an unchanged hash is a build error, not a warning.",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/componentVariant"
      },
      "minItems": 1,
      "type": "array"
    },
    "layout": {
      "additionalProperties": {
        "$ref": "#/$defs/layoutBlock"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Free text for the humans who inherit this file.",
          "maxLength": 400,
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "name": {
          "description": "What this document calls itself. Appears in report provenance and in the studio tab.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "description": "The version of what this document describes — the brand, the kit. Not the format version, which is the root `version`.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "states": {
      "additionalProperties": {
        "additionalProperties": {
          "additionalProperties": false,
          "properties": {
            "background": {
              "anyOf": [
                {
                  "pattern": "^^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$$",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/color"
                }
              ],
              "description": "A token reference, or a literal. A literal is legal and reported as a lint."
            },
            "border": {
              "description": "A dotted reference into the token store, e.g. \"space.lg\".",
              "pattern": "^^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$$",
              "type": "string"
            },
            "color": {
              "anyOf": [
                {
                  "pattern": "^^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$$",
                  "type": "string"
