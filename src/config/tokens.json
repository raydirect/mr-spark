{
  "$schema": "https://mr-spark.pages.dev/schema/settings-0.1.json",
  "version": "0.1",
  "$comment": "A valid settings document, which is the point: the file the report reads and the file a designer authors are one format. This brand is *stricter* than the format in one place — `src/config/tokens.js` requires the space/radius/type/layout/motion groups that the schema leaves optional — because a report with a missing spacing token is a broken report, while a brand that ships colour alone is a legitimate brand.\n\n  The single source of truth for every visual value. The report renderer and the contrast test both read THIS file, so a passing test cannot verify a colour the page does not use. Data, not code, so the Phase 3 editor can import it at runtime with no build step.",
  "meta": {
    "name": "MR-Spark brand",
    "version": "1.0.0",
    "themes": ["light", "dark"]
  },
  "color": {
    "light": {
      "bg": "#ffffff",
      "surface": "#f4f6f8",
      "text": "#14181d",
      "muted": "#4a525c",
      "good": "#0a6b32",
      "warn": "#8a5a00",
      "bad": "#a01b1b",
      "link": "#0b5fd0",
      "border": "#dde2e8",
      "rule": "#eef1f4",
      "impact": {
        "critical": "#a01b1b",
        "serious": "#c2410c",
        "moderate": "#8a5a00",
        "minor": "#6b7684"
      }
    },
    "dark": {
      "bg": "#12161b",
      "surface": "#1a1f26",
      "text": "#e9edf2",
      "muted": "#a7b1bd",
      "good": "#5ec27e",
      "warn": "#e0a44e",
      "bad": "#f07f7f",
      "link": "#85b4ff",
      "border": "#2b333d",
      "rule": "#222932",
      "impact": {
        "critical": "#f07f7f",
        "serious": "#f09a5a",
        "moderate": "#e0a44e",
        "minor": "#8b96a3"
      }
    }
  },
  "contrast": {
    "$comment": "Declared pairs, checked for both themes by test/tokens.test.js and again at import time. Text needs 4.5:1; a non-text boundary that carries meaning needs 3:1. Every foreground token must appear here, or a new colour could ship unchecked.",
    "minimum": { "text": 4.5, "ui": 3 },
    "pairs": [
      { "fg": "text", "bg": "bg", "min": 4.5 },
      { "fg": "text", "bg": "surface", "min": 4.5 },
      { "fg": "muted", "bg": "bg", "min": 4.5 },
      { "fg": "muted", "bg": "surface", "min": 4.5 },
      { "fg": "link", "bg": "bg", "min": 4.5 },
      { "fg": "link", "bg": "surface", "min": 4.5 },
      { "fg": "good", "bg": "bg", "min": 4.5 },
      { "fg": "good", "bg": "surface", "min": 4.5 },
      { "fg": "warn", "bg": "bg", "min": 4.5 },
      { "fg": "warn", "bg": "surface", "min": 4.5 },
      { "fg": "bad", "bg": "bg", "min": 4.5 },
      { "fg": "bad", "bg": "surface", "min": 4.5 }
    ],
    "impactPairs": [
      { "fg": "impact.critical", "bg": "bg", "min": 3 },
      { "fg": "impact.serious", "bg": "bg", "min": 3 },
      { "fg": "impact.moderate", "bg": "bg", "min": 3 },
      { "fg": "impact.minor", "bg": "bg", "min": 3 },
      { "fg": "border", "bg": "bg", "min": 1.2 },
      { "fg": "rule", "bg": "bg", "min": 1.05 }
    ]
  },
  "space": {
    "none": "0",
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "2.5rem",
    "3xl": "3rem",
    "4xl": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "pill": "999px"
  },
  "type": {
    "family": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "3rem"
    },
    "weight": {
      "normal": "400",
      "strong": "600",
      "bold": "700"
    },
    "leading": {
      "tight": "1",
      "body": "1.55"
    },
    "tracking": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.07em"
    },
    "measure": {
      "page": "60rem"
    }
  },
  "layout": {
    "breakpoint": "40rem",
    "scoreRowColumns": "9rem 4rem 1fr",
    "scoreRowColumnsSmall": "7rem 3rem 1fr",
    "twoColumnColumns": "1fr 1fr",
    "twoColumnColumnsSmall": "1fr",
    "borderWidth": "1px",
    "impactBorderWidth": "4px",
    "focusWidth": "2px",
    "focusOffset": "2px"
  },
  "motion": {
    "$comment": "Durations only. Every use must be wrapped in a prefers-reduced-motion guard; motion is never load-bearing.",
    "instant": "0ms",
    "fast": "120ms",
    "base": "200ms"
  }
}
